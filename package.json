{
  "name": "sentinel-evidence-lens",
  "version": "0.1.0",
  "description": "EvidenceLens — permission-aware, evidence-bound retrieval over hash-chained attestations and tenant-scoped policy documents. Prototype.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/src/server.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "seed:pg": "npm run build && node dist/db/seed.js"
  },
  "devDependencies": { "typescript": "^5.6.0", "@types/node": "^22.0.0" },
  "optionalDependencies": { "pg": "^8.13.0" }
}
