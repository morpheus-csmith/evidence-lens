# All optional. The prototype runs with none of these set.
PORT=8787
SESSION_SECRET=change-me-prototype-only
# Model narration / planning (optional). Without a key, a rule-based planner and template narrator are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# PostgreSQL (optional). Without DATABASE_URL, the in-memory store with synthetic data is used.
DATABASE_URL=
